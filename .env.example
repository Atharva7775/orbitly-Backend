# Postgres connection string. Same variable name is used by orbitly-cloud
# (docker-compose.yml, k8s secret orbitly-db, Terraform output database_url).
DATABASE_URL=postgresql+psycopg://orbitly:orbitly@localhost:5432/orbitly

# Redis Streams carry domain events (order.placed, user.signed_up).
REDIS_URL=redis://localhost:6379/0

# Opaque bearer tokens; lifetime of an access token in minutes.
SESSION_TTL_MINUTES=720
BCRYPT_ROUNDS=12

# Browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000

# PayStream gateway (server-side capture). Sandbox key below is a placeholder.
PAYMENTS_API_URL=https://sandbox.paystream-gateway.example
PAYMENTS_API_KEY=sk_test_FAKE_DO_NOT_USE_123

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Orbitly <hello@orbitly.example>
